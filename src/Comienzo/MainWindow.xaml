<Window x:Class="Comienzo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comienzo" Width="560" Height="720"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F21E1E1E" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        SourceInitialized="OnSourceInitialized" Deactivated="OnDeactivated"
        Activated="OnActivated" Closing="OnClosing" PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedResults" Source="{Binding Results}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="SectionName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="ModernThumb" TargetType="Thumb">
            <Setter Property="Height" Value="48" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle x:Name="ThumbSurface" Width="10" Fill="#55FFFFFF"
                                   RadiusX="5" RadiusY="5" Margin="0,2" HorizontalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Fill" Value="#A0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Fill" Value="#C0FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="14" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="NaN"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Height="48" MinHeight="48" Style="{StaticResource ModernThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#16FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#28FFFFFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#20FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F21E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="22,22,22,12">
                <Border Height="48" CornerRadius="9" Background="#18FFFFFF"
                        BorderBrush="#3DFFFFFF" BorderThickness="1,1,1,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                   Foreground="#CCFFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Search apps, settings, or calculate…"
                                   Foreground="#88FFFFFF" FontSize="15" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="#F7FFFFFF" CaretBrush="#60CDFF" FontSize="15"
                                 VerticalContentAlignment="Center" Padding="0,1,12,0"
                                 TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchPreviewKeyDown" />
                    </Grid>
                </Border>
            </Grid>

            <ListBox x:Name="ResultsList" Grid.Row="1" Margin="14,0,14,14"
                     ItemsSource="{Binding Source={StaticResource GroupedResults}}"
                     Background="Transparent" BorderThickness="0" Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewMouseLeftButtonUp="OnResultClick">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#AFFFFFFF" FontSize="12"
                                           FontWeight="SemiBold" Margin="10,13,10,5" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="#F7FFFFFF" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#87FFFFFF" FontSize="11"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
    </Grid>
</Window>
